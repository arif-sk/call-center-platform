<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- One test project, but the tests are grouped by the layer they exercise: the domain rules on
       their own, the use cases over an in-memory database, and the HTTP layer over a stand-in. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\CallCenter.Domain\CallCenter.Domain.csproj" />
    <ProjectReference Include="..\..\src\CallCenter.Application\CallCenter.Application.csproj" />
    <ProjectReference Include="..\..\src\CallCenter.Infrastructure\CallCenter.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\CallCenter.Api\CallCenter.Api.csproj" />
  </ItemGroup>

</Project>
