<Project Sdk="Microsoft.NET.Sdk">

  <!-- The centre of the application. It references nothing: no database, no web framework,
       no third-party package. Everything else points inwards at this. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
